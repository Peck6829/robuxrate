# คัดลอกเป็น .env.local แล้วกรอกค่าจริง (ห้าม commit .env.local)

# ===== แบบ A: XAMPP (MySQL ในเครื่อง) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=robuxrate
DB_SSL=false

# ===== แบบ B: TiDB Cloud (ลบแบบ A ออก แล้วใช้ชุดนี้แทน) =====
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxxxx.root
# DB_PASSWORD=
# DB_NAME=test
# DB_SSL=true

# สุ่มสตริงยาว 32 ตัวอักษรขึ้นไป เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
